Bootstrap: docker
From: mambaorg/micromamba:1.5.8

# =====================================================================
# optiCLIP container — bundles the toolchain of the whole pipeline.
# ---------------------------------------------------------------------
# Two conda envs are created:
#   base       : the Python-3 toolchain (FastQC, FASTX, seqtk, flexbar,
#                cutadapt, STAR, samtools, umi_tools, bedtools, gffread,
#                MultiQC, R+ggplot2, novoalign binary)
#   pyicoclip  : the Python-2 env for pyicos/pyicoclip (legacy)
# Thin wrappers on PATH expose pyicos/pyicoclip from the py2 env.
#
# NOT included / runtime requirements:
#   * Novoalign licence file — bind-mount novoalign.lic at run time.
#   * SPORTS1.1 (mirna.smk) — not conda-packaged; install manually and
#     bind-mount it on PATH (see workflow/envs/sports.yaml). Bowtie1
#     (also needed by mirna.smk) IS included below.
#   * Pin every version before production (versions are unpinned here).
#
# Build:  apptainer build install/opticlip.sif install/Singularity.def
# =====================================================================

%post
    set -eu
    export MAMBA_ROOT_PREFIX=/opt/conda

    # ---- Python-3 toolchain (base env) ----
    micromamba install -y -n base -c conda-forge -c bioconda \
        python=3.11 \
        fastqc fastx_toolkit seqtk flexbar cutadapt \
        star samtools umi_tools bedtools gffread \
        multiqc r-base r-ggplot2 novoalign \
        bowtie=1 perl
    micromamba clean -y --all

    # ---- Python-2 env for pyicoclip (legacy) ----
    micromamba create -y -n pyicoclip -c conda-forge python=2.7 pip
    micromamba run -n pyicoclip pip install pyicoteo
    micromamba clean -y --all

    # ---- expose pyicos/pyicoclip from the py2 env ----
    for tool in pyicos pyicoclip; do
        printf '#!/bin/sh\nexec micromamba run -n pyicoclip %s "$@"\n' "$tool" \
            > "/usr/local/bin/$tool"
        chmod +x "/usr/local/bin/$tool"
    done

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:/usr/local/bin:$PATH

%labels
    Pipeline optiCLIP
    Description Paired-end iCLIP-seq preprocessing to peak calling

%help
    Container for the optiCLIP Snakemake workflow. Use with:
      snakemake --workflow-profile profiles/slurm \
                --software-deployment-method apptainer \
                --apptainer-args '-B /data,/path/to/novoalign.lic'
